# Supabase project URL (public)
NEXT_PUBLIC_SUPABASE_URL=https://qxthvahnevjciwgxlkyi.supabase.co

# Server-only secret key. Set in Vercel Environment Variables; never commit real keys.
SUPABASE_SECRET_KEY=
# Legacy fallback only if your Supabase project still uses service_role:
# SUPABASE_SERVICE_ROLE_KEY=

# Public key used by Supabase Auth on the admin login page.
# Add the Supabase publishable key (sb_publishable_...) or legacy anon key.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Exact email address authorized to view the private admin panel.
ADMIN_EMAIL=
